# Streamlit Cloud Secrets Configuration Template
# Copy this to your Streamlit Cloud dashboard under Settings > Secrets

# HuggingFace Token (Optional - for model access)
# HUGGINGFACE_TOKEN = "your_huggingface_token_here"

# Email Configuration (Optional - for email features)
# EMAIL_USER = "your_email@gmail.com"
# EMAIL_PASS = "your_app_password"

# OpenAI Key (Optional - if using OpenAI instead of HuggingFace)
# OPENAI_API_KEY = "your_openai_key_here"

# Database URL (Optional - for future database features)
# DATABASE_URL = "postgresql://user:password@localhost/dbname"
